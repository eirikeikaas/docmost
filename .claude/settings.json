{
  "permissions": {
    "deny": [
      "Read(./apps/server/src/ee/**)",
      "Read(./apps/client/src/ee/**)",
      "Read(./packages/ee/**)",
      "Read(./packages/base-formula/**)",
      "Edit(./apps/server/src/ee/**)",
      "Edit(./apps/client/src/ee/**)",
      "Edit(./packages/ee/**)",
      "Edit(./packages/base-formula/**)"
    ]
  },
  "sandbox": {
    "filesystem": {
      "denyRead": [
        "./apps/server/src/ee",
        "./apps/client/src/ee",
        "./packages/ee",
        "./packages/base-formula"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob|Edit|Write|NotebookEdit|Bash|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/block-ee.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
